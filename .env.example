# Discord
DISCORD_BOT_TOKEN=
ALLOWED_CHANNEL_ID=

# Anthropic
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-4-6
MAX_TOKENS=2000

# GitLab (deploy token lecture seule, scope read_repository)
REPO_URL=https://gitlab.example.com/<groupe>/site-infoclimat.git
REPO_BRANCH=feat/data-platform-bootstrap
GITLAB_DEPLOY_USER=
GITLAB_DEPLOY_TOKEN=

# Chemins (dans le conteneur)
CLONE_DIR=/data/site-infoclimat
DATAPLATFORM_SNAPSHOT_DIR=/data/site-infoclimat/data-platform
BUDGET_STATE_PATH=/var/lib/ic-data-bot/token_budget.json

# Santé / refresh
HEALTH_BIND=0.0.0.0
HEALTH_PORT=8080
REFRESH_INTERVAL_SECONDS=3600

# Garde-fous
USER_RATE_LIMIT=5
RATE_WINDOW_SECONDS=60
DAILY_TOKEN_BUDGET=500000
TOOL_READ_MAX_BYTES=60000
HISTORY_TTL_SECONDS=1800
HISTORY_MAX_TURNS=5

# Errata des devs (!fix)
CORRECTIONS_PATH=/var/lib/ic-data-bot/corrections.jsonl

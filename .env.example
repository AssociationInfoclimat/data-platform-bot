# Discord
DISCORD_BOT_TOKEN=
ALLOWED_CHANNEL_ID=

# Fournisseur LLM : anthropic (défaut) ou mistral.
PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Requis seulement si PROVIDER=mistral
MISTRAL_API_KEY=
# Modèle de raisonnement (Magistral) pour !deep et l'expliqueur d'incident
MISTRAL_REASONING_MODEL=magistral-small-latest
# Id du modèle pour le PROVIDER actif (ex. claude-haiku-4-5 / mistral-small-latest)
MODEL=claude-haiku-4-5
MAX_TOKENS=2000

# Repo data-platform (public — créds inutiles ; laisser vide pour un clone anonyme)
REPO_URL=https://github.com/AssociationInfoclimat/data-platform.git
REPO_BRANCH=main
GITLAB_DEPLOY_USER=
GITLAB_DEPLOY_TOKEN=

# Chemins (dans le conteneur)
CLONE_DIR=/data/data-platform
DATAPLATFORM_SNAPSHOT_DIR=/data/data-platform
BUDGET_STATE_PATH=/var/lib/ic-data-bot/token_budget.json

# Santé / refresh
HEALTH_BIND=0.0.0.0
HEALTH_PORT=8080
REFRESH_INTERVAL_SECONDS=3600

# Garde-fous
USER_RATE_LIMIT=5
RATE_WINDOW_SECONDS=60
DAILY_TOKEN_BUDGET=500000
TOOL_READ_MAX_BYTES=60000
HISTORY_TTL_SECONDS=1800
HISTORY_MAX_TURNS=5

# Errata des devs (!fix)
CORRECTIONS_PATH=/var/lib/ic-data-bot/corrections.jsonl

# Mapping ops interne (complément confidentiel au repo public, jamais commité).
# Copié dans le snapshot sous _ops/ au démarrage et à chaque refresh.
OPS_MAPPING_PATH=/var/lib/ic-data-bot/ops-mapping.yaml

# Issues GitHub depuis !fix (optionnel — sans token, !fix reste local au bot).
# PAT fine-grained : repo data-platform uniquement, permission Issues Read+Write.
GITHUB_TOKEN=
GITHUB_ISSUES_REPO=AssociationInfoclimat/data-platform

# Alerte de vie (optionnel) : webhook Discord notifié par scripts/liveness-check.sh
# (cron sur l'hôte) quand le conteneur n'est plus healthy, + message de rétablissement.
DISCORD_ALERT_WEBHOOK=

# Fraîcheur temps réel (optionnel) : canaux Discord où Kestra notifie ses runs.
# Le bot les écoute (+ backfill au démarrage) pour l'outil kestra_recent.
KESTRA_EVENTS_CHANNEL_ID=
KESTRA_ALERTS_CHANNEL_ID=

# Expliqueur d'incident (défaut : actif si KESTRA_ALERTS_CHANNEL_ID est défini).
# Sur un Flow FAILED dans #alerts : analyse d'impact postée en fil sous l'alerte.
# INCIDENT_EXPLAINER=0 pour désactiver.

# Observabilité Langfuse (optionnel) : tracing du bot + scores d'éval.
# Sans clés → désactivé. Cloud EU par défaut.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Rédaction des détails internes (IP, domaines homelab) avant envoi (recommandé sur Cloud).
LANGFUSE_REDACT=1

# ── Serveur MCP data-platform (ic-data-bot-mcp, conteneur SÉPARÉ) ──
# Réexpose read_file/grep/lineage (mode public : _ops/ refusé) + resources + prompt en
# streamable-HTTP pour Claude Code & tout client MCP. Snapshot DÉDIÉ, clone ANONYME du
# repo public data-platform. ⚠️ NE PAS définir OPS_MAPPING_PATH pour ce service.
MCP_BEARER_TOKEN=changeme-long-random
# Tokens additionnels (CSV), un par personne → révocable individuellement (retirer + restart).
# Générer : openssl rand -hex 24
# MCP_BEARER_TOKENS=tokenAlice,tokenBob
# Libellés des tokens pour l'observabilité Langfuse (CSV token:nom). Sans mapping, l'identité
# tracée = user-<hash8> (stable, anonyme). Le tracing MCP est actif si les clés LANGFUSE sont là.
# MCP_TOKEN_LABELS=tokenAlice:alice,tokenBob:bob
MCP_PORT=8765
# MCP_HOST=0.0.0.0
# MCP_REFRESH_SECONDS=3600
# Hôte(s) public(s) autorisé(s) (CSV) derrière le reverse-proxy (validation Host MCP).
# Vide → protection anti-DNS-rebinding désactivée (on s'appuie sur le proxy + bearer).
# MCP_ALLOWED_HOSTS=mcp.example.org
